# Production Dockerfile for Decoupled AI Compute Workers (STT, LLM, TTS, supervisor)
FROM python:3.11-slim

WORKDIR /app

# ffmpeg lets Faster-Whisper decode WAV, WebM/Opus and OGG uploads
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install lightweight CPU-only torch first (~180MB instead of 2.8GB CUDA), then worker dependencies
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

COPY . /app

# Run as an unprivileged user (uid 1001); its home holds the Whisper / HuggingFace caches.
RUN useradd --create-home --uid 1001 voxa && chown -R voxa:voxa /app
USER voxa

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "workers.llm_worker"]
