# Copy to voxa-backend/.env for running the gateway/workers directly on your machine
# (pydantic-settings reads .env from the working directory). With docker compose, put
# overrides in a root-level .env instead (see docker-compose.yml).

# Database & cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxa_db
REDIS_URL=redis://localhost:6379/0

# Security & JWT (generate with: openssl rand -hex 32). If unset, a random key is
# generated per process start and every issued token becomes invalid on restart.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Used only when admin@voxa.ai is first created; changing it later does not change the
# stored password.
SEED_ADMIN_PASSWORD=adminpassword123

# Browser origins allowed by CORS (regex). Default: any localhost / 127.0.0.1 port.
# Example for a public host: ^https?://(localhost|203\.0\.113\.10)(:[0-9]+)?$
CORS_ALLOW_ORIGIN_REGEX=

# Rate limiting (sliding window, requests per minute per user or IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_FORWARDED_FOR=false

# Gemini writes the replies (get a key at https://aistudio.google.com/apikey). Leave the
# key empty to answer with the plain replies built by the intent router.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Model configuration (Whisper size for the STT worker, edge-tts voice, embedding model)
STT_MODEL_SIZE=base
TTS_VOICE=en-US-AriaNeural
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
