# Production Dockerfile for FastAPI Edge Gateway (Optimized for CPU & Low Disk Footprint)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-gateway.txt .

# Install lightweight CPU-only torch first, then gateway dependencies
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements-gateway.txt

COPY . /app

# Run as an unprivileged user (uid 1001); its home holds the HuggingFace model cache.
RUN useradd --create-home --uid 1001 voxa && chown -R voxa:voxa /app
USER voxa

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# One worker per container: Prometheus metrics and WebSocket gauges are process-local,
# so scale out with more containers/replicas (each scraped separately), not --workers.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
